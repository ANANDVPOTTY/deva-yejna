# Google Form embed URL for the Contact Us page.
# Copy this file to `.env` and adjust as needed.
# NOTE: This is NOT a secret — Vite inlines VITE_* vars into the public client
# bundle at build time, so anything here is visible to end users.
VITE_CONTACT_FORM_URL=https://docs.google.com/forms/d/e/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/viewform?embedded=true
